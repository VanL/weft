#!/usr/bin/env python3
"""Structural gate for the [DOM-15] classification fixture table.

Checks the enumerable contract of DOM-15 (the Enumerable Contracts
principle, section 9 in this repository's engineering principles):
  1. every fixture row names a known class (0-5, `Class N+P`, or an
     explicit `Escalate to N` transition)
  2. every class 0-5 and the +P modifier each appear in at least one
     fixture
  3. class-1 and class-2 fixtures state their negative-trigger facts
  4. the subsume/cumulative rule sentence is present

Exit codes (truthful in classes): 0 clean, 1 contract violation,
2 invocation error. Never prints a traceback. Semantic classification
of real tasks is judgment and is NOT checked here — see [DOM-15].

Usage:
  check-dom15-fixtures [--spec PATH] [--self-test]
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

DEFAULT_SPEC = "docs/agent-context/decision-hierarchy.md"

CLASS_CELL_RE = re.compile(r"^(?:[0-5]\b|Class\s+[0-5]\+P\b|Escalate to [0-5]\b)")
# Adopters: this pattern tuple is repo-adapted by design. When your
# fixtures use local phrasing (name-based triggers, different negation
# wording), EXTEND this tuple — do not reword your fixtures back to
# canonical brackets.
NEGATIVE_FACT_PATTERNS = (
    re.compile(
        r"\bno(?: other)? \[DOM-5\][^.;,—\[]*?\btriggers?\s+fires?\b",
        re.IGNORECASE,
    ),
    re.compile(
        r"\bno(?: other)? (?:non-trivial or risky |risky or non-trivial )?triggers?\s+fires?\b",
        re.IGNORECASE,
    ),
    re.compile(r"\bno (?:observable )?behavior change\b", re.IGNORECASE),
    re.compile(r"\bnot \[DOM-6\]-material\b", re.IGNORECASE),
    re.compile(r"\bnot material\b", re.IGNORECASE),
    re.compile(r"\bnothing changes\b", re.IGNORECASE),
)
TRIGGER_FIRE_RE = re.compile(
    r"(?:\[DOM-[56]\][^.;,—\[]*?|(?:non-trivial|risky)(?:\s+or\s+(?:non-trivial|risky))?\s+)\btriggers?(?:,\s*)?\s+fires?\b",
    re.IGNORECASE,
)
CLAUSE_SPLIT_RE = re.compile(
    r"[,;.—]|\b(?:but|yet|and|while|though|although|however)\b", re.IGNORECASE
)


def _fence_marker(line: str) -> tuple[str, int, str] | None:
    leading_spaces = len(line) - len(line.lstrip(" "))
    stripped = line[leading_spaces:]
    if leading_spaces <= 3 and stripped.startswith(("```", "~~~")):
        char = stripped[0]
        length = len(stripped) - len(stripped.lstrip(char))
        return (char, length, stripped[length:])
    return None


def _closes_fence(marker: tuple[str, int, str] | None, fence: tuple[str, int]) -> bool:
    return (
        marker is not None
        and marker[0] == fence[0]
        and marker[1] >= fence[1]
        and not marker[2].strip()
    )


def strip_fenced_blocks(text: str) -> str:
    """Remove fenced blocks so grammar mimicry inside them is inert."""
    output: list[str] = []
    fence: tuple[str, int] | None = None
    for line in text.splitlines():
        marker = _fence_marker(line)
        if fence is None and marker is not None:
            fence = (marker[0], marker[1])
            continue
        if fence is not None:
            if _closes_fence(marker, fence):
                fence = None
            continue
        output.append(line)
    return "\n".join(output)


def extract_section(text: str) -> str | None:
    lines = strip_fenced_blocks(text).splitlines()
    start = None
    for i, line in enumerate(lines):
        if line.startswith("## ") and "[DOM-15]" in line:
            start = i
            break
    if start is None:
        return None
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if lines[j].startswith("## "):
            end = j
            break
    return "\n".join(lines[start:end])


def fixture_rows(section: str) -> list[tuple[str, str]]:
    rows, in_table = [], False
    for line in section.splitlines():
        if line.startswith("| Fixture"):
            in_table = True
            continue
        if in_table:
            if not line.startswith("|"):
                in_table = False
                continue
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            if len(cells) >= 2 and not set(cells[0]) <= {"-", " "}:
                rows.append((cells[0], cells[1]))
    return rows


def states_firing_trigger(fact: str) -> bool:
    """True when any trigger-fire clause in `fact` is not directly negated."""
    for clause in CLAUSE_SPLIT_RE.split(fact):
        for match in TRIGGER_FIRE_RE.finditer(clause):
            prefix = clause[: match.start()]
            if not re.search(r"\bno(?: other)?\s+$", prefix, re.IGNORECASE):
                return True
    return False


def has_negative_fact(fact: str) -> bool:
    """True when at least one clause states a valid negative-trigger fact."""
    return any(
        p.search(clause)
        for clause in CLAUSE_SPLIT_RE.split(fact)
        for p in NEGATIVE_FACT_PATTERNS
    )


def _record_row(
    fact: str, cls: str, seen_classes: set[str], problems: list[str]
) -> None:
    if not CLASS_CELL_RE.match(cls):
        problems.append(f"unknown class cell: {cls!r} (fixture: {fact[:50]}...)")
        return
    if "+P" in cls:
        seen_classes.add("+P")
        seen_classes.add(cls.split()[1].split("+")[0])
    elif cls.startswith("Escalate to"):
        seen_classes.add(cls.split()[-1][0])
    else:
        seen_classes.add(cls[0])
    if cls[0] in ("1", "2") and not cls.startswith("Escalate"):
        if not has_negative_fact(fact):
            problems.append(
                f"class-{cls[0]} fixture missing negative-trigger facts: {fact[:60]}..."
            )
        if states_firing_trigger(fact):
            problems.append(
                f"class-{cls[0]} fixture states that a trigger fires: {fact[:60]}..."
            )


def check(section: str) -> list[str]:
    problems: list[str] = []
    rows = fixture_rows(section)
    if not rows:
        return ["no fixture table found in the [DOM-15] section"]

    seen_classes: set[str] = set()
    for fact, cls in rows:
        _record_row(fact, cls, seen_classes, problems)

    for required in ("0", "1", "2", "3", "4", "5", "+P"):
        if required not in seen_classes:
            problems.append(f"no fixture covers class {required}")

    if "subsume" not in section:
        problems.append("cumulative/subsume rule sentence is absent")
    return problems


GOOD_SAMPLE = """## 15. Task Classification [DOM-15]

planning artifacts **subsume**: floors accumulate

| Fixture (trigger facts stated) | Class |
|---------|-------|
| survey — nothing changes | 0 |
| typo — no behavior change | 1 |
| fix per spec — the cited section is the intent evidence; no [DOM-5] trigger fires | 2 |
| multi-surface work | 3 |
| CLI flag | 4 |
| spec edit | 5 (strategy D) |
| skill change | Class 3+P (effective 5) |
| discovers risky trigger | Escalate to 4 at that moment |
"""


def _fence_probe_failures() -> list[str]:
    """Fence probes go through extract_section — the real invocation path
    that strips fences; calling check() directly would bypass stripping
    and pass or fail vacuously."""
    failures: list[str] = []

    def full_check(text: str) -> list[str]:
        section = extract_section(text)
        return ["no section"] if section is None else check(section)

    bogus_table = (
        "| Fixture (trigger facts stated) | Class |\n"
        "|---------|-------|\n"
        "| probe row | 9 |\n"
    )
    probes = [
        (
            "fenced-block fixture text was not ignored",
            GOOD_SAMPLE + "\n```\n| bogus | 9 |\n```\n",
            False,
        ),
        (
            "nested-fence interior leaked into the fixture table",
            GOOD_SAMPLE
            + (
                "\n````markdown\n```\n"
                "| Fixture (trigger facts stated) | Class |\n"
                "|---------|-------|\n"
                "| nested-fence example | 9 |\n"
                "````\n"
            ),
            False,
        ),
        (
            "tilde-fenced fixture text was not ignored",
            GOOD_SAMPLE + "\n~~~\n" + bogus_table + "~~~\n",
            False,
        ),
        (
            "mismatched-character line closed a fence early",
            GOOD_SAMPLE + "\n```\n~~~\n" + bogus_table + "```\n",
            False,
        ),
        (
            "info-string line closed a fence early",
            GOOD_SAMPLE + "\n```\n``` markdown\n" + bogus_table + "```\n",
            False,
        ),
        (
            "unclosed fence leaked its interior",
            GOOD_SAMPLE + "\n````markdown\n```\n" + bogus_table,
            False,
        ),
        (
            "4-space-indented line was wrongly treated as a fence",
            GOOD_SAMPLE + "\n    ```\n" + bogus_table + "    ```\n",
            True,
        ),
    ]
    for msg, sample, expect_errors in probes:
        if bool(full_check(sample)) != expect_errors:
            failures.append(msg)
    return failures


def self_test() -> int:
    failures = []
    if check(GOOD_SAMPLE):
        failures.append(f"good sample should pass, got: {check(GOOD_SAMPLE)}")
    mutations = {
        "unknown class": GOOD_SAMPLE.replace("| 0 |", "| 9 |"),
        "missing +P fixture": GOOD_SAMPLE.replace(
            "| skill change | Class 3+P (effective 5) |\n", ""
        ),
        "stripped negative facts": GOOD_SAMPLE.replace(
            "typo — no behavior change", "typo"
        ),
        "firing trigger hidden behind negative marker": GOOD_SAMPLE.replace(
            "typo — no behavior change",
            "typo — no behavior change; a [DOM-5] risky trigger fires",
        ),
        "firing trigger after negated trigger in same sentence": GOOD_SAMPLE.replace(
            "no [DOM-5] trigger fires",
            "no [DOM-5] non-trivial trigger fires, but a [DOM-5] risky trigger fires",
        ),
        "firing trigger after conjunction without comma": GOOD_SAMPLE.replace(
            "no [DOM-5] trigger fires",
            "no [DOM-5] non-trivial changes but a [DOM-5] risky trigger fires",
        ),
        "firing trigger after though without comma": GOOD_SAMPLE.replace(
            "no [DOM-5] trigger fires",
            "no [DOM-5] non-trivial changes though a [DOM-5] risky trigger fires",
        ),
        "firing trigger after although without comma": GOOD_SAMPLE.replace(
            "no [DOM-5] trigger fires",
            "no [DOM-5] non-trivial changes although a [DOM-5] risky trigger fires",
        ),
        "firing trigger after however without comma": GOOD_SAMPLE.replace(
            "no [DOM-5] trigger fires",
            "no [DOM-5] non-trivial changes however a [DOM-5] risky trigger fires",
        ),
        "intent evidence alone without negative trigger fact": GOOD_SAMPLE.replace(
            "no [DOM-5] trigger fires", "reversible"
        ),
        "deleted subsume rule": GOOD_SAMPLE.replace("subsume", "combine"),
    }
    for name, mutated in mutations.items():
        if not check(mutated):
            failures.append(f"mutation not caught: {name}")
    failures.extend(_fence_probe_failures())
    # probe: missing target is an invocation error, not a crash
    if run(["--spec", "/nonexistent/dom15-spec.md"]) != 2:
        failures.append("missing spec file did not exit with invocation-error class")
    if failures:
        for f in failures:
            print(f"check-dom15-fixtures self-test FAIL: {f}")
        return 1
    print("check-dom15-fixtures self-test: all mutation cases and probes pass")
    return 0


def run(argv: list[str]) -> int:
    spec = Path(DEFAULT_SPEC)
    args = list(argv)
    if "--spec" in args:
        i = args.index("--spec")
        try:
            spec = Path(args[i + 1])
        except IndexError:
            print("check-dom15-fixtures: --spec requires a path")
            return 2
    try:
        text = spec.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"check-dom15-fixtures: cannot read spec {spec}: {exc.strerror}")
        return 2
    section = extract_section(text)
    if section is None:
        print(f"check-dom15-fixtures: no [DOM-15] section in {spec}")
        return 2
    problems = check(section)
    if problems:
        for p in problems:
            print(f"check-dom15-fixtures: {p}")
        return 1
    print(f"check-dom15-fixtures: {spec} [DOM-15] fixture contract OK")
    return 0


def main() -> int:
    argv = sys.argv[1:]
    if "--self-test" in argv:
        return self_test()
    return run(argv)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # noqa: BLE001 approved [TS-3.1] [RUFF-SUP-357] exception
        print(f"check-dom15-fixtures: internal error: {exc}")
        sys.exit(2)
