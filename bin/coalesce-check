#!/usr/bin/env python3
"""Evidence trail for weft's coalescing layer session-start check.

The run log's source_sha cues are the layer's retrieval contract, and
until this gate they were unchecked prose — the 2026-07-28 field audit
found weft cues that resolve locally but not in published history. This
tool:

  1. verifies every `<sha>` cited in docs/coalescing.md resolves
     (`git cat-file -e`), here or in an identifiable sibling repo;
  2. verifies every `git show <sha>:<path>` cue's path exists at that
     SHA;
  3. checks each local SHA against the published remote (origin),
     reporting `local-only pin` where it does not resolve there — a cue
     that survives only on one machine is a claim the world cannot
     verify;
  4. derives the lessons-tier count with weft's documented derivation
     so a session-start check can quote real numbers.

Weft-local adaptation (adopted from agent-guidance @ 51626db via
docs/plans/2026-07-28-agent-guidance-propagation-plan.md): the
lessons derivation is weft's declared command — dated **H2 sections**
(`^## 20[0-9]{2}-`), not the hub's dated bullets — and the sibling list
is written from weft's vantage so the run log's agent-guidance and mm
cues resolve. docs/coalescing.md remains the spec; if this script and
that file disagree, the file wins and this script is the defect.

Read-only by construction. Exit 1 only on an unresolvable cue (a broken
retrieval contract); local-only pins and count reports are
informational — publication discipline is the owner's call.
"""
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
STATE = REPO_ROOT / "docs" / "coalescing.md"

SHA_RE = re.compile(r"`([0-9a-f]{7,40})`")
CUE_RE = re.compile(r"git show ([0-9a-f]{7,40}):([A-Za-z0-9_./-]+)")

# Foreign attribution is a REPORTING aid, never a resolution mechanism: it
# names repositories this repo's own citations refer to, makes no filesystem
# assumption, and resolves nothing.
FOREIGN_MARKERS = ("agent-theory", "agent-guidance", "mm", "weft", "taut",
                   "backstitch", "engram", "simplebroker")

# Opt-in local convenience, unset by default. A sibling working copy is an
# environment fact, not a portability claim: anything found this way is
# reported separately and never counted as verified.
SIBLING_ROOT = os.environ.get("COALESCE_SIBLING_ROOT")

# Weft's declared lessons derivation: dated H2 sections.
LESSON_RE = re.compile(r"^## 20[0-9]{2}-", re.M)


def git(*args: str, repo: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(repo or REPO_ROOT), *args],
        capture_output=True,
        text=True,
    )


def attributed_repo(text: str, pos: int) -> str | None:
    """Does the citation name the repository it came from? Reporting only."""
    ctx = text[max(0, pos - 80):pos].lower()
    hits = [m for m in FOREIGN_MARKERS if m in ctx]
    return max(hits, key=len) if hits else None


def resolves_locally(sha: str) -> bool:
    return git("cat-file", "-e", f"{sha}^{{commit}}").returncode == 0


def in_local_checkout(sha: str) -> str | None:
    """Opt-in only (COALESCE_SIBLING_ROOT). Environment-dependent by nature,
    so the caller reports it as such and never as verification."""
    if not SIBLING_ROOT:
        return None
    root = Path(SIBLING_ROOT)
    if not root.is_dir():
        return None
    for cand in sorted(root.iterdir()):
        if (cand / ".git").exists() and \
                git("cat-file", "-e", f"{sha}^{{commit}}", repo=cand).returncode == 0:
            return cand.name
    return None

def main() -> int:  # noqa: C901 approved [TS-3.1] [RUFF-SUP-224] exception
    if not STATE.is_file():
        print("coalesce-check: no docs/coalescing.md — nothing to check")
        return 0
    text = STATE.read_text()

    sha_hits = [(m.group(1), m.start()) for m in SHA_RE.finditer(text)]
    cues = sorted(set(CUE_RE.findall(text)))

    remote_ok = (
        git("rev-parse", "--verify", "origin/HEAD").returncode == 0
        or git("rev-parse", "--verify", "origin/main").returncode == 0
    )

    broken: list[str] = []
    local_only: list[str] = []
    broken, local_only, foreign = [], [], []
    seen = set()
    for sha, pos in sha_hits:
        if sha in seen:
            continue
        seen.add(sha)
        if resolves_locally(sha):
            if remote_ok and git("merge-base", "--is-ancestor", sha,
                                 "origin/main").returncode != 0:
                local_only.append(sha)
            continue
        who = attributed_repo(text, pos)
        if who:
            extra = in_local_checkout(sha)
            foreign.append(f"{sha} @ {who}" +
                           (f" (present in a local checkout of {extra})" if extra else ""))
        else:
            broken.append(f"`{sha}` resolves nowhere here and names no "
                          "repository — a cue must say where it is retrievable")

    for sha, path in cues:
        if not (resolves_locally(sha) and
                git("cat-file", "-e", f"{sha}:{path}").returncode == 0):
            broken.append(f"cue `git show {sha}:{path}` does not resolve here")


    lessons = REPO_ROOT / "docs" / "lessons.md"
    count = 0
    if lessons.is_file():
        count = len(LESSON_RE.findall(lessons.read_text()))

    print(
        f"coalesce-check: {len(seen)} SHA claim(s) "
        f"({len(foreign)} foreign claim(s)), "
        f"{len(cues)} retrieval cue(s); lessons dated H2 sections: {count}"
    )
    if foreign:
        print(f"  foreign claim ({len(foreign)}) — not verifiable in this repository;\n    check the citing repository: " + ", ".join(foreign))
    if local_only:
        print(
            f"  local-only pin ({len(local_only)}): " + ", ".join(local_only)
            + "  [not in origin/main — published history cannot verify these]"
        )
    if broken:
        print(f"  BROKEN ({len(broken)}):")
        for b in broken:
            print(f"    {b}")
        return 1
    print(
        "  all cues resolve"
        + ("" if remote_ok else "  [no origin remote — publication check skipped]")
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
