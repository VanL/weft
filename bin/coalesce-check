#!/usr/bin/env python3
"""Evidence trail for weft's coalescing layer session-start check.

The run log's source_sha cues are the layer's retrieval contract, and
until this gate they were unchecked prose — the 2026-07-28 field audit
found weft cues that resolve locally but not in published history. This
tool:

  1. verifies every `<sha>` cited in docs/coalescing.md resolves
     (`git cat-file -e`), here or in an identifiable sibling repo;
  2. verifies every `git show <sha>:<path>` cue's path exists at that
     SHA (including retired-plan cues in docs/plans/README.md);
  3. checks each local SHA against the published remote (origin),
     reporting `local-only pin` where it does not resolve there — a cue
     that survives only on one machine is a claim the world cannot
     verify;
  4. derives the lessons-tier count with weft's documented derivation
     so a session-start check can quote real numbers.

Weft-local adaptation (adopted from agent-guidance @ 51626db via
docs/plans/2026-07-28-agent-guidance-propagation-plan.md and updated to
agent-theory @ 8f41a9d via
docs/plans/2026-10-14-agent-theory-delta-wave-plan.md): the
lessons derivation is weft's declared command — dated **H2 sections**
(`^## 20[0-9]{2}-`), not the hub's dated bullets — and the sibling list
is written from weft's vantage so the run log's agent-guidance and mm
cues resolve. docs/coalescing.md remains the spec; if this script and
that file disagree, the file wins and this script is the defect.

Read-only by construction. Exit 1 only on an unresolvable cue (a broken
retrieval contract); local-only pins and count reports are
informational — publication discipline is the owner's call.

On a shallow clone the SHA-resolution and retrieval-cue legs cannot be
truthful (history is absent), so they are SKIPPED loudly with exit 0 —
a false BROKEN is as invalid as a silent pass. Enforcement CI must run
this gate on full history (checkout with fetch-depth: 0).
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
STATE = REPO_ROOT / "docs" / "coalescing.md"

SHA_RE = re.compile(r"`([0-9a-f]{7,40})`")
CUE_RE = re.compile(r"git show ([0-9a-f]{7,40}):([A-Za-z0-9_./-]+)")

# Foreign attribution is a REPORTING aid, never a resolution mechanism: it
# names repositories this repo's own citations refer to, makes no filesystem
# assumption, and resolves nothing.
FOREIGN_MARKERS = (
    "agent-theory",
    "agent-guidance",
    "mm",
    "weft",
    "taut",
    "backstitch",
    "engram",
    "simplebroker",
)
FOREIGN_MARKER_RE = re.compile(
    r"\b(" + "|".join(re.escape(m) for m in FOREIGN_MARKERS) + r")\b"
)

# Opt-in local convenience, unset by default. A sibling working copy is an
# environment fact, not a portability claim: anything found this way is
# reported separately and never counted as verified.
SIBLING_ROOT = os.environ.get("COALESCE_SIBLING_ROOT")

# Weft's declared lessons derivation: dated H2 sections.
LESSON_RE = re.compile(r"^## 20[0-9]{2}-", re.MULTILINE)


def git(*args: str, repo: Path | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repo or REPO_ROOT), *args],
        capture_output=True,
        text=True,
        check=False,
    )


def attributed_repo(text: str, pos: int) -> str | None:
    """Does the citation name the repository it came from? Reporting only."""
    ctx = text[max(0, pos - 80) : pos].lower()
    hits = list(FOREIGN_MARKER_RE.finditer(ctx))
    return hits[-1].group(1) if hits else None


def resolves_locally(sha: str) -> bool:
    return git("cat-file", "-e", f"{sha}^{{commit}}").returncode == 0


def in_local_checkout(sha: str) -> str | None:
    """Opt-in only (COALESCE_SIBLING_ROOT). Environment-dependent by nature,
    so the caller reports it as such and never as verification."""
    if not SIBLING_ROOT:
        return None
    root = Path(SIBLING_ROOT)
    if not root.is_dir():
        return None
    for cand in sorted(root.iterdir()):
        if (cand / ".git").exists() and git(
            "cat-file", "-e", f"{sha}^{{commit}}", repo=cand
        ).returncode == 0:
            return cand.name
    return None


def resolve_remote_ref() -> str | None:
    """Resolve the default remote branch via origin/HEAD, falling back to origin/main."""
    sym = git("symbolic-ref", "-q", "--short", "refs/remotes/origin/HEAD")
    if sym.returncode == 0 and sym.stdout.strip():
        cand = sym.stdout.strip()
        if git("rev-parse", "--verify", cand).returncode == 0:
            return cand
    for fallback in ("origin/main", "origin/HEAD"):
        if git("rev-parse", "--verify", fallback).returncode == 0:
            return fallback
    return None


def _retired_table_lines(lines: list[str]) -> list[str]:
    in_retired = False
    in_table = False
    table_lines: list[str] = []
    for line in lines:
        if line.startswith("## "):
            in_retired = line.strip() == "## Retired Plans"
            in_table = False
            continue
        if in_retired and line.startswith("| Plan"):
            in_table = True
            continue
        if in_table:
            if not line.startswith("|"):
                in_table = False
                continue
            table_lines.append(line)
    return table_lines


def _parse_retired_row(line: str) -> tuple[str, str] | None:
    cells = [c.strip() for c in line.strip().strip("|").split("|")]
    if len(cells) < 2 or set(cells[0]) <= {"-", " "}:
        return None
    plan_cell = cells[0].strip("`").strip()
    sha_match = SHA_RE.search(cells[-1])
    if not plan_cell or not sha_match:
        return None
    rel = (
        plan_cell if plan_cell.startswith("docs/plans/") else f"docs/plans/{plan_cell}"
    )
    if not rel.endswith(".md"):
        rel = f"{rel}.md"
    return (sha_match.group(1), rel)


def retired_plan_cues() -> list[tuple[str, str]]:
    """Extract (sha, repo_relative_plan_path) from ## Retired Plans in docs/plans/README.md."""
    readme = REPO_ROOT / "docs" / "plans" / "README.md"
    if not readme.is_file():
        return []
    lines = readme.read_text(errors="replace").splitlines()
    results: list[tuple[str, str]] = []
    for line in _retired_table_lines(lines):
        parsed = _parse_retired_row(line)
        if parsed is not None:
            results.append(parsed)
    return results


def main() -> int:  # noqa: C901 approved [TS-3.1] [RUFF-SUP-224] exception
    if not STATE.is_file():
        print("coalesce-check: no docs/coalescing.md — nothing to check")
        return 0
    text = STATE.read_text()

    if git("rev-parse", "--is-shallow-repository").stdout.strip() == "true":
        lessons = REPO_ROOT / "docs" / "lessons.md"
        count = 0
        if lessons.is_file():
            count = len(LESSON_RE.findall(lessons.read_text()))
        cues = sorted(set(CUE_RE.findall(text)) | set(retired_plan_cues()))
        print(
            "coalesce-check: shallow clone detected — SHA-resolution and "
            "retrieval-cue checks SKIPPED (history absent; cues cannot be "
            "verified here). Enforcement requires full history "
            "(fetch-depth: 0)."
        )
        print(f"  retrieval cues found (syntax only, unverified here): {len(cues)}")
        print(f"  lessons dated H2 sections: {count}")
        return 0

    sha_hits = [(m.group(1), m.start()) for m in SHA_RE.finditer(text)]
    retired_cues = retired_plan_cues()
    cues = sorted(set(CUE_RE.findall(text)) | set(retired_cues))

    remote_ref = resolve_remote_ref()
    remote_ok = remote_ref is not None

    broken: list[str] = []
    local_only: list[str] = []
    foreign: list[str] = []
    seen: set[str] = set()
    for sha, pos in sha_hits:
        if sha in seen:
            continue
        seen.add(sha)
        if resolves_locally(sha):
            if (
                remote_ref
                and git("merge-base", "--is-ancestor", sha, remote_ref).returncode != 0
            ):
                local_only.append(sha)
            continue
        who = attributed_repo(text, pos)
        if who:
            extra = in_local_checkout(sha)
            foreign.append(
                f"{sha} @ {who}"
                + (f" (present in a local checkout of {extra})" if extra else "")
            )
        else:
            broken.append(
                f"`{sha}` resolves nowhere here and names no "
                "repository — a cue must say where it is retrievable"
            )

    for sha, path in cues:
        if not (
            resolves_locally(sha)
            and git("cat-file", "-e", f"{sha}:{path}").returncode == 0
        ):
            broken.append(f"cue `git show {sha}:{path}` does not resolve here")
        elif sha not in seen:
            seen.add(sha)
            if (
                remote_ref
                and git("merge-base", "--is-ancestor", sha, remote_ref).returncode != 0
            ):
                local_only.append(sha)

    lessons = REPO_ROOT / "docs" / "lessons.md"
    count = 0
    if lessons.is_file():
        count = len(LESSON_RE.findall(lessons.read_text()))

    print(
        f"coalesce-check: {len(seen)} SHA claim(s) "
        f"({len(foreign)} foreign claim(s)), "
        f"{len(cues)} retrieval cue(s) ({len(retired_cues)} retired-plan cue(s)); "
        f"lessons dated H2 sections: {count}"
    )
    if foreign:
        print(
            f"  foreign claim ({len(foreign)}) — not verifiable in this repository;\n    check the citing repository: "
            + ", ".join(foreign)
        )
    if local_only:
        print(
            f"  local-only pin ({len(local_only)}): "
            + ", ".join(local_only)
            + f"  [not in {remote_ref} — published history cannot verify these]"
        )
    if broken:
        print(f"  BROKEN ({len(broken)}):")
        for b in broken:
            print(f"    {b}")
        return 1
    print(
        "  all cues resolve locally"
        + ("" if remote_ok else "  [no origin remote — publication check skipped]")
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
