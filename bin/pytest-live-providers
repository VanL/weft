#!/usr/bin/env python
"""Run the local live provider-cli release smoke tests once."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from collections.abc import Sequence
from pathlib import Path
from typing import Final

from weft.core.agents.provider_cli.registry import list_provider_cli_providers

ROOT: Final[Path] = Path(__file__).resolve().parents[1]
LIVE_PROVIDER_TARGET_ENV: Final[str] = "WEFT_LIVE_PROVIDER_CLI_TARGETS"
LIVE_PROVIDER_QWEN_MODEL_ENV: Final[str] = "WEFT_LIVE_PROVIDER_CLI_MODEL_QWEN"
RUN_LIVE_PROVIDER_ENV: Final[str] = "WEFT_RUN_LIVE_PROVIDER_CLI_TESTS"
RUN_LIVE_PROVIDER_MCP_ENV: Final[str] = "WEFT_RUN_LIVE_PROVIDER_CLI_MCP_TESTS"
OPENROUTER_API_KEY_ENV: Final[str] = "OPENROUTER_API_KEY"
QWEN_DEFAULT_AUTH_TYPE_ENV: Final[str] = "QWEN_DEFAULT_AUTH_TYPE"
OPENAI_API_KEY_ENV: Final[str] = "OPENAI_API_KEY"
OPENAI_BASE_URL_ENV: Final[str] = "OPENAI_BASE_URL"
OPENROUTER_BASE_URL: Final[str] = "https://openrouter.ai/api/v1"
OPENROUTER_SMOKE_MODEL: Final[str] = "poolside/laguna-s-2.1:free"


def build_pytest_command(provider_names: Sequence[str]) -> tuple[str, ...]:
    """Build the exact pytest command for live provider smoke coverage."""

    smoke_nodes = tuple(
        "tests/tasks/test_agent_execution.py::"
        f"test_consumer_live_provider_cli_smoke[{provider_name}]"
        for provider_name in provider_names
    )
    persistent_nodes = tuple(
        "tests/tasks/test_agent_execution.py::"
        f"test_consumer_live_provider_cli_persistent_smoke[{provider_name}]"
        for provider_name in provider_names
    )
    mcp_nodes = (
        (
            (
                "tests/tasks/test_agent_execution.py::"
                "test_consumer_live_provider_cli_mcp_smoke"
            ),
        )
        if "claude_code" in provider_names
        else ()
    )
    return (
        sys.executable,
        "-m",
        "pytest",
        "-m",
        "",
        "-n",
        "0",
        "-x",
        "--maxfail=1",
        "--override-ini=addopts=-ra -q --strict-markers",
        *smoke_nodes,
        *persistent_nodes,
        *mcp_nodes,
    )


def resolve_live_provider_targets(explicit_targets: str | None) -> tuple[str, ...]:
    """Resolve explicit or auto-discovered live provider targets."""

    requested = {
        entry.strip() for entry in (explicit_targets or "").split(",") if entry.strip()
    }
    if not requested:
        return tuple(
            provider.name
            for provider in list_provider_cli_providers()
            if shutil.which(provider.default_executable) is not None
        )

    registered_providers = list_provider_cli_providers()
    providers = {provider.name: provider for provider in registered_providers}
    known = set(providers)
    unknown = sorted(requested - known)
    if unknown:
        raise ValueError(
            "Unknown live provider target: "
            f"{unknown[0]}. Known targets: {', '.join(sorted(known))}"
        )

    selected = tuple(
        provider.name for provider in registered_providers if provider.name in requested
    )
    missing = tuple(
        provider_name
        for provider_name in selected
        if shutil.which(providers[provider_name].default_executable) is None
    )
    if missing:
        raise ValueError(
            f"Selected provider_cli target(s) are not installed: {', '.join(missing)}"
        )
    return selected


def build_provider_env(
    provider_name: str,
    *,
    base_env: dict[str, str],
) -> dict[str, str]:
    """Build one provider-scoped live-test environment.

    Provider CLIs can use the same generic credential variables for unrelated
    services. Running each provider in its own process keeps those credentials
    from changing another provider's authentication path.
    """

    env = base_env.copy()
    env[RUN_LIVE_PROVIDER_ENV] = "1"
    env[LIVE_PROVIDER_TARGET_ENV] = provider_name
    env[RUN_LIVE_PROVIDER_MCP_ENV] = "1" if provider_name == "claude_code" else "0"
    env["PYTEST_ADDOPTS"] = ""

    openrouter_api_key = env.get(OPENROUTER_API_KEY_ENV, "").strip()
    qwen_auth_is_explicit = bool(
        env.get(QWEN_DEFAULT_AUTH_TYPE_ENV, "").strip()
        or env.get(OPENAI_BASE_URL_ENV, "").strip()
    )
    if provider_name == "qwen" and openrouter_api_key and not qwen_auth_is_explicit:
        # Qwen OAuth's free tier was discontinued in 2026. Use Qwen's supported
        # OpenAI-compatible automation path when an OpenRouter credential is
        # already available, without exposing it to the other provider CLIs.
        env[QWEN_DEFAULT_AUTH_TYPE_ENV] = "openai"
        env[OPENAI_API_KEY_ENV] = openrouter_api_key
        env[OPENAI_BASE_URL_ENV] = OPENROUTER_BASE_URL
        env.setdefault(LIVE_PROVIDER_QWEN_MODEL_ENV, OPENROUTER_SMOKE_MODEL)

    return env


def main() -> int:
    try:
        provider_names = resolve_live_provider_targets(
            os.environ.get(LIVE_PROVIDER_TARGET_ENV)
        )
    except ValueError as exc:
        print(f"pytest-live-providers: {exc}", file=sys.stderr)
        return 2
    if not provider_names:
        print(
            "No registered provider_cli executable is available on PATH; "
            f"set {LIVE_PROVIDER_TARGET_ENV}=<provider> after installing a CLI.",
            file=sys.stderr,
        )
        return 1

    base_env = os.environ.copy()
    for provider_name in provider_names:
        result = subprocess.run(
            build_pytest_command((provider_name,)),
            cwd=ROOT,
            env=build_provider_env(provider_name, base_env=base_env),
            check=False,
        )
        if result.returncode != 0:
            return result.returncode
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
